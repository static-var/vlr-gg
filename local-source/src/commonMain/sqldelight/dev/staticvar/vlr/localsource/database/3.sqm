ALTER TABLE favorite_teams ADD COLUMN active INTEGER NOT NULL DEFAULT 1;
ALTER TABLE favorite_teams ADD COLUMN notification_topic TEXT;
ALTER TABLE favorite_teams ADD COLUMN topic_synced INTEGER NOT NULL DEFAULT 0;

ALTER TABLE favorite_events ADD COLUMN active INTEGER NOT NULL DEFAULT 1;
ALTER TABLE favorite_events ADD COLUMN notification_topic TEXT;
ALTER TABLE favorite_events ADD COLUMN topic_synced INTEGER NOT NULL DEFAULT 0;

ALTER TABLE favorite_matches ADD COLUMN active INTEGER NOT NULL DEFAULT 1;
ALTER TABLE favorite_matches ADD COLUMN notification_topic TEXT;
ALTER TABLE favorite_matches ADD COLUMN topic_synced INTEGER NOT NULL DEFAULT 0;

ALTER TABLE favorite_players ADD COLUMN active INTEGER NOT NULL DEFAULT 1;
ALTER TABLE favorite_players ADD COLUMN notification_topic TEXT;
ALTER TABLE favorite_players ADD COLUMN topic_synced INTEGER NOT NULL DEFAULT 0;

DROP VIEW cache_protected_players;
DROP VIEW cache_protected_teams;
DROP VIEW cache_protected_events;
DROP VIEW cache_protected_matches;
DROP VIEW cache_favorite_matches;

CREATE VIEW cache_favorite_matches AS
SELECT m.id AS match_id
FROM matches AS m
WHERE EXISTS (
    SELECT 1 FROM favorite_matches AS favorite WHERE favorite.active = 1 AND favorite.match_id = m.id
)
OR EXISTS (
    SELECT 1 FROM favorite_events AS favorite WHERE favorite.active = 1 AND favorite.event_id = m.event_id
)
OR EXISTS (
    SELECT 1
    FROM event_matches AS event_match
    INNER JOIN favorite_events AS favorite ON favorite.event_id = event_match.event_id AND favorite.active = 1
    WHERE event_match.match_id = m.id
)
OR EXISTS (
    SELECT 1
    FROM favorite_teams AS favorite
    WHERE favorite.active = 1 AND favorite.team_id != ''
      AND (favorite.team_id = m.team1_id OR favorite.team_id = m.team2_id)
)
OR EXISTS (
    SELECT 1
    FROM favorite_players AS favorite
    INNER JOIN players AS player ON player.id = favorite.player_id
    WHERE favorite.active = 1 AND player.current_team_id IS NOT NULL
      AND player.current_team_id != ''
      AND (player.current_team_id = m.team1_id OR player.current_team_id = m.team2_id)
);

CREATE VIEW cache_protected_matches AS
SELECT match_id FROM cache_favorite_matches
UNION
SELECT encounter.previous_match_id AS match_id
FROM match_previous_encounters AS encounter
INNER JOIN cache_favorite_matches AS favorite ON favorite.match_id = encounter.match_id;

CREATE VIEW cache_protected_events AS
SELECT event_id
FROM favorite_events
WHERE active = 1
UNION
SELECT cached_match.event_id
FROM matches AS cached_match
INNER JOIN cache_protected_matches AS protected ON protected.match_id = cached_match.id
WHERE cached_match.event_id IS NOT NULL AND cached_match.event_id != ''
UNION
SELECT event_match.event_id
FROM event_matches AS event_match
INNER JOIN cache_protected_matches AS protected ON protected.match_id = event_match.match_id;

CREATE VIEW cache_protected_teams AS
SELECT team_id
FROM favorite_teams
WHERE active = 1
UNION
SELECT player.current_team_id AS team_id
FROM players AS player
INNER JOIN favorite_players AS favorite ON favorite.player_id = player.id AND favorite.active = 1
WHERE player.current_team_id IS NOT NULL AND player.current_team_id != ''
UNION
SELECT cached_match.team1_id AS team_id
FROM matches AS cached_match
INNER JOIN cache_protected_matches AS protected ON protected.match_id = cached_match.id
WHERE cached_match.team1_id != ''
UNION
SELECT cached_match.team2_id AS team_id
FROM matches AS cached_match
INNER JOIN cache_protected_matches AS protected ON protected.match_id = cached_match.id
WHERE cached_match.team2_id != ''
UNION
SELECT event_team.team_id
FROM event_teams AS event_team
INNER JOIN cache_protected_events AS protected ON protected.event_id = event_team.event_id
WHERE event_team.team_id IS NOT NULL AND event_team.team_id != '';

CREATE VIEW cache_protected_players AS
SELECT player_id
FROM favorite_players
WHERE active = 1
UNION
SELECT stats.player_id
FROM match_map_player_stats AS stats
INNER JOIN cache_protected_matches AS protected ON protected.match_id = stats.match_id
WHERE stats.player_id != ''
UNION
SELECT roster.player_id
FROM team_roster AS roster
INNER JOIN cache_protected_teams AS protected ON protected.team_id = roster.team_id
WHERE roster.player_id != '';

CREATE TRIGGER prune_inactive_favorite_teams
AFTER UPDATE OF active ON favorite_teams
BEGIN
    DELETE FROM favorite_teams WHERE active = 0 AND notification_topic IS NULL;
END;

CREATE TRIGGER prune_inactive_favorite_events
AFTER UPDATE OF active ON favorite_events
BEGIN
    DELETE FROM favorite_events WHERE active = 0 AND notification_topic IS NULL;
END;

CREATE TRIGGER prune_inactive_favorite_matches
AFTER UPDATE OF active ON favorite_matches
BEGIN
    DELETE FROM favorite_matches WHERE active = 0 AND notification_topic IS NULL;
END;

CREATE TRIGGER prune_inactive_favorite_players
AFTER UPDATE OF active ON favorite_players
BEGIN
    DELETE FROM favorite_players WHERE active = 0 AND notification_topic IS NULL;
END;
