CREATE TABLE match_insights (
    match_id TEXT NOT NULL PRIMARY KEY,
    team1_id TEXT NOT NULL,
    team2_id TEXT NOT NULL,
    insights_json TEXT NOT NULL,
    FOREIGN KEY(match_id) REFERENCES matches(id) ON DELETE CASCADE
);

getMatchInsights:
SELECT * FROM match_insights WHERE match_id = :matchId;

upsertMatchInsights:
INSERT OR REPLACE INTO match_insights(match_id, team1_id, team2_id, insights_json)
VALUES (?, ?, ?, ?);

deleteMatchInsights:
DELETE FROM match_insights WHERE match_id = :matchId;
