-- Rankings and seasonal standings tables

CREATE TABLE rankings (
    team_id TEXT NOT NULL,
    region TEXT NOT NULL,
    team_name TEXT NOT NULL DEFAULT '',
    team_logo TEXT NOT NULL DEFAULT '',
    country TEXT NOT NULL DEFAULT '',
    rank INTEGER NOT NULL,
    points TEXT NOT NULL,
    last_updated INTEGER NOT NULL DEFAULT 0,
    PRIMARY KEY (team_id, region)
);

CREATE INDEX idx_rankings_region ON rankings(region);
CREATE INDEX idx_rankings_rank ON rankings(region, rank);

CREATE TABLE standings (
    team_id TEXT NOT NULL,
    year INTEGER NOT NULL,
    circuit TEXT NOT NULL,
    region TEXT NOT NULL,
    team_name TEXT NOT NULL DEFAULT '',
    team_logo TEXT NOT NULL DEFAULT '',
    country TEXT NOT NULL DEFAULT '',
    rank INTEGER NOT NULL,
    points TEXT NOT NULL,
    last_updated INTEGER NOT NULL DEFAULT 0,
    PRIMARY KEY (team_id, year, circuit)
);

CREATE INDEX idx_standings_year_region ON standings(year, region);
CREATE INDEX idx_standings_circuit ON standings(circuit);

-- ============================================================================
-- QUERIES
-- ============================================================================

insertRanking:
INSERT OR REPLACE INTO rankings(team_id, region, rank, points, last_updated)
VALUES (?, ?, ?, ?, ?);

insertRankingDetails:
INSERT OR REPLACE INTO rankings(team_id, region, team_name, team_logo, country, rank, points, last_updated)
VALUES (?, ?, ?, ?, ?, ?, ?, ?);

getRankingsByRegion:
SELECT * FROM rankings WHERE region = :region ORDER BY rank ASC;

getAllRankings:
SELECT * FROM rankings ORDER BY region ASC, rank ASC;

deleteRankingsByRegion:
DELETE FROM rankings WHERE region = :region;

deleteAllRankings:
DELETE FROM rankings;

insertStanding:
INSERT OR REPLACE INTO standings(team_id, year, circuit, region, rank, points, last_updated)
VALUES (?, ?, ?, ?, ?, ?, ?);

insertStandingDetails:
INSERT OR REPLACE INTO standings(team_id, year, circuit, region, team_name, team_logo, country, rank, points, last_updated)
VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?);

getStandingsByYearAndRegion:
SELECT * FROM standings WHERE year = :year AND region = :region ORDER BY rank ASC;

getStandingsByYear:
SELECT * FROM standings WHERE year = :year ORDER BY circuit ASC, rank ASC;

getStandingsByCircuit:
SELECT * FROM standings WHERE circuit = :circuit ORDER BY year DESC, rank ASC;

getStandingsByYearAndCircuit:
SELECT * FROM standings WHERE year = :year AND circuit = :circuit ORDER BY rank ASC;

deleteStandingsByYearAndRegion:
DELETE FROM standings WHERE year = :year AND region = :region;

deleteStandingsByYear:
DELETE FROM standings WHERE year = :year;

deleteAllStandings:
DELETE FROM standings;
