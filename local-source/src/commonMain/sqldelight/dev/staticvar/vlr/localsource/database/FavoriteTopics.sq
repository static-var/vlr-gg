getFavoriteTopicRecords:
SELECT 'TEAM' AS entity_type, favorite.team_id AS id, favorite.active,
       favorite.notification_topic, favorite.topic_synced, NULL AS current_team_id
FROM favorite_teams AS favorite
UNION ALL
SELECT 'EVENT' AS entity_type, favorite.event_id AS id, favorite.active,
       favorite.notification_topic, favorite.topic_synced, NULL AS current_team_id
FROM favorite_events AS favorite
UNION ALL
SELECT 'MATCH' AS entity_type, favorite.match_id AS id, favorite.active,
       favorite.notification_topic, favorite.topic_synced, NULL AS current_team_id
FROM favorite_matches AS favorite
UNION ALL
SELECT 'PLAYER' AS entity_type, favorite.player_id AS id, favorite.active,
       favorite.notification_topic, favorite.topic_synced, player.current_team_id
FROM favorite_players AS favorite
LEFT JOIN players AS player ON player.id = favorite.player_id;

setTeamTopic:
UPDATE favorite_teams SET notification_topic = :topic, topic_synced = :synced WHERE team_id = :id;

invalidateTeamTopicAcknowledgements:
UPDATE favorite_teams SET topic_synced = 0;

acknowledgeTeamTopic:
UPDATE favorite_teams SET topic_synced = 1 WHERE notification_topic = :topic;

clearTeamTopic:
UPDATE favorite_teams SET notification_topic = NULL, topic_synced = 0 WHERE notification_topic = :topic;

pruneInactiveTeamFavorites:
DELETE FROM favorite_teams WHERE active = 0 AND notification_topic IS NULL;

