DROP VIEW IF EXISTS cache_protected_players;
DROP VIEW IF EXISTS cache_protected_teams;
DROP VIEW IF EXISTS cache_protected_events;
DROP VIEW IF EXISTS cache_protected_matches;
DROP VIEW IF EXISTS cache_favorite_matches;

CREATE INDEX IF NOT EXISTS idx_player_agent_stats_usage ON player_agent_stats(player_id, usage_count);

-- Older v1 event matches had a cascading match foreign key that was later removed.
CREATE TABLE event_matches_v2 (
    id INTEGER PRIMARY KEY AUTOINCREMENT,
    event_id TEXT NOT NULL,
    match_id TEXT NOT NULL,
    time TEXT NOT NULL DEFAULT '',
    date TEXT NOT NULL DEFAULT '',
    eta TEXT,
    status TEXT NOT NULL DEFAULT '',
    team1_name TEXT NOT NULL DEFAULT '',
    team1_region TEXT NOT NULL DEFAULT '',
    team1_score INTEGER,
    team2_name TEXT NOT NULL DEFAULT '',
    team2_region TEXT NOT NULL DEFAULT '',
    team2_score INTEGER,
    round TEXT NOT NULL DEFAULT '',
    stage TEXT NOT NULL DEFAULT '',
    FOREIGN KEY(event_id) REFERENCES events(id) ON DELETE CASCADE,
    UNIQUE(event_id, match_id)
);

INSERT INTO event_matches_v2 (id, event_id, match_id, time, date, status, eta, team1_name, team1_region, team1_score, team2_name, team2_region, team2_score, stage, round)
SELECT id, event_id, match_id, time, date, status, eta, team1_name, team1_region, team1_score, team2_name, team2_region, team2_score, stage, round FROM event_matches;

DROP TABLE event_matches;
ALTER TABLE event_matches_v2 RENAME TO event_matches;
CREATE INDEX IF NOT EXISTS idx_event_matches_event_id ON event_matches(event_id);
CREATE INDEX IF NOT EXISTS idx_event_matches_match_id ON event_matches(match_id);

-- Version 1 shipped with multiple schemas; existing cache tables must be retained.

CREATE TABLE IF NOT EXISTS match_overview (
    id TEXT NOT NULL PRIMARY KEY,
    event_id TEXT,
    event_name TEXT NOT NULL,
    series TEXT NOT NULL,
    status TEXT NOT NULL,
    time TEXT NOT NULL,
    team1_id TEXT NOT NULL,
    team1_name TEXT NOT NULL,
    team1_logo_url TEXT NOT NULL,
    team1_score INTEGER,
    team2_id TEXT NOT NULL,
    team2_name TEXT NOT NULL,
    team2_logo_url TEXT NOT NULL,
    team2_score INTEGER
);

CREATE INDEX IF NOT EXISTS idx_match_overview_status_time ON match_overview(status, time);

CREATE TABLE IF NOT EXISTS event_overview (
    id TEXT NOT NULL PRIMARY KEY,
    name TEXT NOT NULL,
    status TEXT,
    prizes TEXT NOT NULL,
    dates TEXT NOT NULL,
    region TEXT,
    logo_url TEXT NOT NULL,
    list_position INTEGER NOT NULL DEFAULT 0
);

-- Retain cleanup history when upgrading builds that already have this table.
CREATE TABLE IF NOT EXISTS cache_cleanup_state (
    id INTEGER NOT NULL PRIMARY KEY CHECK (id = 1),
    deleted_records INTEGER NOT NULL DEFAULT 0,
    last_run_epoch_millis INTEGER
);

-- A match is retained when it is a direct favorite or inherits favorite status from
-- its event, either team, or a favorite player's current team.
CREATE VIEW IF NOT EXISTS cache_favorite_matches AS
SELECT m.id AS match_id
FROM matches AS m
WHERE EXISTS (
    SELECT 1 FROM favorite_matches AS favorite WHERE favorite.match_id = m.id
)
OR EXISTS (
    SELECT 1 FROM favorite_events AS favorite WHERE favorite.event_id = m.event_id
)
OR EXISTS (
    SELECT 1
    FROM event_matches AS event_match
    INNER JOIN favorite_events AS favorite ON favorite.event_id = event_match.event_id
    WHERE event_match.match_id = m.id
)
OR EXISTS (
    SELECT 1
    FROM favorite_teams AS favorite
    WHERE favorite.team_id != ''
      AND (favorite.team_id = m.team1_id OR favorite.team_id = m.team2_id)
)
OR EXISTS (
    SELECT 1
    FROM favorite_players AS favorite
    INNER JOIN players AS player ON player.id = favorite.player_id
    WHERE player.current_team_id IS NOT NULL
      AND player.current_team_id != ''
      AND (player.current_team_id = m.team1_id OR player.current_team_id = m.team2_id)
);

-- Previous-match placeholders are retained when deleting them would cascade away
-- head-to-head rows belonging to a favorite match.
CREATE VIEW IF NOT EXISTS cache_protected_matches AS
SELECT match_id FROM cache_favorite_matches
UNION
SELECT encounter.previous_match_id AS match_id
FROM match_previous_encounters AS encounter
INNER JOIN cache_favorite_matches AS favorite ON favorite.match_id = encounter.match_id;

CREATE VIEW IF NOT EXISTS cache_protected_events AS
SELECT event_id
FROM favorite_events
UNION
SELECT cached_match.event_id
FROM matches AS cached_match
INNER JOIN cache_protected_matches AS protected ON protected.match_id = cached_match.id
WHERE cached_match.event_id IS NOT NULL AND cached_match.event_id != ''
UNION
SELECT event_match.event_id
FROM event_matches AS event_match
INNER JOIN cache_protected_matches AS protected ON protected.match_id = event_match.match_id;

CREATE VIEW IF NOT EXISTS cache_protected_teams AS
SELECT team_id
FROM favorite_teams
UNION
SELECT player.current_team_id AS team_id
FROM players AS player
INNER JOIN favorite_players AS favorite ON favorite.player_id = player.id
WHERE player.current_team_id IS NOT NULL AND player.current_team_id != ''
UNION
SELECT cached_match.team1_id AS team_id
FROM matches AS cached_match
INNER JOIN cache_protected_matches AS protected ON protected.match_id = cached_match.id
WHERE cached_match.team1_id != ''
UNION
SELECT cached_match.team2_id AS team_id
FROM matches AS cached_match
INNER JOIN cache_protected_matches AS protected ON protected.match_id = cached_match.id
WHERE cached_match.team2_id != ''
UNION
SELECT event_team.team_id
FROM event_teams AS event_team
INNER JOIN cache_protected_events AS protected ON protected.event_id = event_team.event_id
WHERE event_team.team_id IS NOT NULL AND event_team.team_id != '';

CREATE VIEW IF NOT EXISTS cache_protected_players AS
SELECT player_id
FROM favorite_players
UNION
SELECT stats.player_id
FROM match_map_player_stats AS stats
INNER JOIN cache_protected_matches AS protected ON protected.match_id = stats.match_id
WHERE stats.player_id != ''
UNION
SELECT roster.player_id
FROM team_roster AS roster
INNER JOIN cache_protected_teams AS protected ON protected.team_id = roster.team_id
WHERE roster.player_id != '';

