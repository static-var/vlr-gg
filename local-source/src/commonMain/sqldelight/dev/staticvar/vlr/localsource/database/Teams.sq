-- Teams and related tables

CREATE TABLE teams (
    id TEXT NOT NULL PRIMARY KEY,
    name TEXT NOT NULL,
    tag TEXT NOT NULL DEFAULT '',
    logo_url TEXT NOT NULL,
    region TEXT,
    country TEXT NOT NULL,
    roster_url TEXT,
    earnings TEXT,
    rank INTEGER NOT NULL DEFAULT 0,
    website TEXT,
    twitter TEXT,
    last_updated INTEGER NOT NULL DEFAULT 0
);

CREATE INDEX idx_team_region ON teams(region);
CREATE INDEX idx_team_country ON teams(country);
CREATE INDEX idx_team_rank ON teams(rank);

-- Team roster (historical/current membership)
CREATE TABLE team_roster (
    id INTEGER PRIMARY KEY AUTOINCREMENT,
    team_id TEXT NOT NULL,
    player_id TEXT NOT NULL,
    player_name TEXT NOT NULL,
    player_alias TEXT NOT NULL DEFAULT '',
    player_image_url TEXT NOT NULL DEFAULT '',
    player_country TEXT NOT NULL DEFAULT '',
    is_stand_in INTEGER NOT NULL DEFAULT 0,
    is_coach INTEGER NOT NULL DEFAULT 0,
    is_current INTEGER NOT NULL DEFAULT 1,
    role TEXT,
    FOREIGN KEY(team_id) REFERENCES teams(id) ON DELETE CASCADE,
    UNIQUE(team_id, player_id)
);

CREATE INDEX idx_team_roster_team_id ON team_roster(team_id);
CREATE INDEX idx_team_roster_player_id ON team_roster(player_id);

-- Team upcoming matches (lightweight schedule cache)
CREATE TABLE team_upcoming_matches (
    id INTEGER PRIMARY KEY AUTOINCREMENT,
    team_id TEXT NOT NULL,
    match_id TEXT NOT NULL,
    opponent_team_id TEXT,
    opponent_team_name TEXT NOT NULL,
    opponent_team_logo_url TEXT NOT NULL DEFAULT '',
    date TEXT NOT NULL,
    eta TEXT,
    event_name TEXT NOT NULL,
    event_logo_url TEXT NOT NULL,
    event_id TEXT,
    stage TEXT NOT NULL DEFAULT '',
    FOREIGN KEY(team_id) REFERENCES teams(id) ON DELETE CASCADE,
    UNIQUE(team_id, match_id)
);

CREATE INDEX idx_team_upcoming_team_id ON team_upcoming_matches(team_id);
CREATE INDEX idx_team_upcoming_date ON team_upcoming_matches(team_id, date);

-- Team completed matches (recent history)
CREATE TABLE team_completed_matches (
    id INTEGER PRIMARY KEY AUTOINCREMENT,
    team_id TEXT NOT NULL,
    match_id TEXT NOT NULL,
    opponent_team_id TEXT,
    opponent_team_name TEXT NOT NULL,
    opponent_team_logo_url TEXT NOT NULL DEFAULT '',
    date TEXT NOT NULL,
    event_name TEXT NOT NULL,
    event_logo_url TEXT NOT NULL,
    event_id TEXT,
    stage TEXT NOT NULL DEFAULT '',
    result TEXT NOT NULL DEFAULT '',
    FOREIGN KEY(team_id) REFERENCES teams(id) ON DELETE CASCADE,
    UNIQUE(team_id, match_id)
);

CREATE INDEX idx_team_completed_team_id ON team_completed_matches(team_id);
CREATE INDEX idx_team_completed_date ON team_completed_matches(team_id, date);

-- Favorites (device only)
CREATE TABLE favorite_teams (
    team_id TEXT NOT NULL PRIMARY KEY
);

-- ============================================================================
-- QUERIES
-- ============================================================================

insertTeam:
INSERT OR REPLACE INTO teams VALUES ?;

getTeamsWithFavoriteStatus:
SELECT
    t.*,
    CAST((fav.team_id IS NOT NULL) AS INTEGER) AS is_favorite
FROM teams AS t
LEFT JOIN favorite_teams AS fav ON t.id = fav.team_id
ORDER BY t.rank ASC, t.name ASC;

getTeamWithFavoriteStatus:
SELECT
    t.*,
    CAST((fav.team_id IS NOT NULL) AS INTEGER) AS is_favorite
FROM teams AS t
LEFT JOIN favorite_teams AS fav ON t.id = fav.team_id
WHERE t.id = :teamId;

getTeamsByRegion:
SELECT
    t.*,
    CAST((fav.team_id IS NOT NULL) AS INTEGER) AS is_favorite
FROM teams AS t
LEFT JOIN favorite_teams AS fav ON t.id = fav.team_id
WHERE t.region = :region
ORDER BY t.rank ASC, t.name ASC;

deleteAllTeams:
DELETE FROM teams;

deleteTeamById:
DELETE FROM teams WHERE id = :teamId;

-- Roster queries
insertTeamRosterMember:
INSERT OR REPLACE INTO team_roster(team_id, player_id, player_name, player_country, is_stand_in, is_coach, is_current, role)
VALUES (?, ?, ?, ?, ?, ?, ?, ?);

insertTeamRosterMemberDetails:
INSERT OR REPLACE INTO team_roster(
    team_id, player_id, player_name, player_alias, player_image_url,
    player_country, is_stand_in, is_coach, is_current, role
)
VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?);

getTeamRoster:
SELECT * FROM team_roster WHERE team_id = :teamId ORDER BY is_current DESC, player_name ASC;

deleteTeamRoster:
DELETE FROM team_roster WHERE team_id = :teamId;

-- Upcoming matches queries
insertUpcomingMatch:
INSERT OR REPLACE INTO team_upcoming_matches(team_id, match_id, opponent_team_id, opponent_team_name, opponent_team_logo_url, date, event_name, event_logo_url, event_id)
VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?);

insertUpcomingMatchDetails:
INSERT OR REPLACE INTO team_upcoming_matches(
    team_id, match_id, opponent_team_id, opponent_team_name, opponent_team_logo_url,
    date, eta, event_name, event_logo_url, event_id, stage
)
VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?);

getUpcomingMatches:
SELECT * FROM team_upcoming_matches WHERE team_id = :teamId ORDER BY date ASC;

deleteUpcomingMatches:
DELETE FROM team_upcoming_matches WHERE team_id = :teamId;

-- Completed matches queries
insertCompletedMatch:
INSERT OR REPLACE INTO team_completed_matches(team_id, match_id, opponent_team_id, opponent_team_name, opponent_team_logo_url, date, event_name, event_logo_url, event_id, result)
VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?);

insertCompletedMatchDetails:
INSERT OR REPLACE INTO team_completed_matches(
    team_id, match_id, opponent_team_id, opponent_team_name, opponent_team_logo_url,
    date, event_name, event_logo_url, event_id, stage, result
)
VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?);

getCompletedMatches:
SELECT * FROM team_completed_matches WHERE team_id = :teamId ORDER BY date DESC;

deleteCompletedMatches:
DELETE FROM team_completed_matches WHERE team_id = :teamId;

-- Favorites queries
addFavoriteTeam:
INSERT OR IGNORE INTO favorite_teams(team_id) VALUES (?);

removeFavoriteTeam:
DELETE FROM favorite_teams WHERE team_id = ?;

isFavoriteTeam:
SELECT COUNT(*) FROM favorite_teams WHERE team_id = :teamId;

getAllFavoriteTeams:
SELECT t.*, 1 AS is_favorite
FROM teams AS t
INNER JOIN favorite_teams AS fav ON t.id = fav.team_id
ORDER BY t.rank ASC, t.name ASC;

getFavoriteTeamIds:
SELECT team_id FROM favorite_teams;
