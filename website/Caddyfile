valesports.app {
  # CNAME _acme-challenge.valesports.app to the DNS challenge target below.
  tls {
    dns_challenge_override_domain _acme-challenge.valesports.staticvar.dev
  }
  encode zstd gzip
  header {
    X-Content-Type-Options nosniff
    Referrer-Policy strict-origin-when-cross-origin
    X-Frame-Options DENY
    Permissions-Policy "camera=(), microphone=(), geolocation=()"
    Content-Security-Policy "default-src 'none'; script-src 'self'; style-src 'self'; font-src 'self'; img-src 'self'; base-uri 'none'; form-action 'self'; frame-ancestors 'none'"
  }
  @documents path_regexp documents (\.html|/)$
  header @documents >Cache-Control "no-cache"
  @forms path /api/testflight-signups /api/support-requests
  handle @forms {
    reverse_proxy valorant-esports-signup:8080 {
      header_up X-Forwarded-For {remote_host}
    }
  }
  handle {
    reverse_proxy valorant-esports-web:8080
  }
}

www.valesports.app {
  # CNAME _acme-challenge.www.valesports.app to the DNS challenge target below.
  tls {
    dns_challenge_override_domain _acme-challenge.www.valesports.staticvar.dev
  }
  redir https://valesports.app{uri} 308
}

valorantesports.staticvar.dev {
  @associations path /.well-known/apple-app-site-association /.well-known/assetlinks.json
  handle @associations {
    reverse_proxy valorant-esports-web:8080
  }
  handle {
    redir https://valesports.app{uri} 308
  }
}
