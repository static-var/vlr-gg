valorantesports.staticvar.dev {
  encode zstd gzip
  header {
    X-Content-Type-Options nosniff
    Referrer-Policy strict-origin-when-cross-origin
    X-Frame-Options DENY
    Permissions-Policy "camera=(), microphone=(), geolocation=()"
    Content-Security-Policy "default-src 'none'; style-src 'self'; font-src 'self'; img-src 'self'; base-uri 'none'; form-action 'self'; frame-ancestors 'none'"
  }
  handle /api/testflight-signups {
    reverse_proxy valorant-esports-signup:8080 {
      header_up X-Forwarded-For {remote_host}
    }
  }
  handle {
    reverse_proxy valorant-esports-web:8080
  }
}
