    "Find your next live or upcoming favorite match without revealing scores." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : { "stringUnit" : { "state" : "translated", "value" : "Finde dein nächstes laufendes oder bevorstehendes Favoriten-Match, ohne Ergebnisse anzuzeigen." } },
