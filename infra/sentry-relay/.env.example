# Copy to .env and replace these values before running configure.py.
# Copy only the hostname from the original Sentry project DSN.
SENTRY_UPSTREAM_HOST=
# Comma-separated project-id:public-key pairs. Include both mobile projects if separate.
SENTRY_PROJECT_KEYS=
# A hostname you own, routed through the server's existing HTTPS ingress.
PUBLIC_HOST=
# Nexus normally uses appsnet. Use the existing server ingress network.
INGRESS_NETWORK=appsnet
