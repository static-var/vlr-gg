    <string name="release_introduction">Follow VALORANT in your language, with clearer logos and a more reliable connection at startup.</string>
    <string name="release_languages_title">Now in 9 languages</string>
    <string name="release_languages_description">The app now follows your device language, with support for English, Hindi, Spanish, French, German, Brazilian Portuguese, Russian, Turkish, and Korean.</string>
    <string name="release_logos_title">Clearer team and event logos</string>
    <string name="release_logos_description">Team and event logos keep their original colors, including in rankings. Backgrounds adjust for contrast so logos stay easy to see in light and dark themes.</string>
    <string name="release_connectivity_title">More reliable startup</string>
    <string name="release_connectivity_description">Connection checks at startup are more reliable, helping the app recognize when you are online.</string>
