<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    tools:ignore="PrivateResource,Overdraw,HardcodedText,UseCompatTextViewDrawableXml,UseAppTint"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:minWidth="280dp"
    android:minHeight="158dp"
    android:orientation="vertical"
    android:padding="16dp"
    android:background="@color/glance_colorWidgetBackground">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">
        <TextView
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:background="@drawable/favorite_widget_preview_tile"
            android:fontFamily="sans-serif-medium"
            android:gravity="center"
            android:text="CHA"
            android:textColor="@color/glance_colorOnSecondaryContainer"
            android:textSize="10sp" />
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:orientation="vertical">
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-medium"
                android:maxLines="1"
                android:text="Champions Paris"
                android:textColor="@color/glance_colorOnSurface"
                android:textSize="16sp" />
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:text="Paris"
                android:textColor="@color/glance_colorOnSurfaceVariant"
                android:textSize="13sp" />
        </LinearLayout>
        <ImageView
            android:layout_width="10dp"
            android:layout_height="10dp"
            android:src="@drawable/favorite_widget_live"
            android:tint="@color/glance_colorError"
            android:importantForAccessibility="no" />
    </LinearLayout>
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">
        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:fontFamily="sans-serif-medium"
            android:maxLines="1"
            android:text="LOUD · Team Vitality"
            android:textColor="@color/glance_colorOnSurface"
            android:textSize="13sp" />
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:fontFamily="sans-serif-medium"
            android:maxLines="1"
            android:text="@string/widget_favorite_live"
            android:textColor="@color/glance_colorError"
            android:textSize="13sp" />
    </LinearLayout>
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">
        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:maxLines="1"
            android:text="2–1"
            android:textColor="@color/glance_colorOnSurface"
            android:textSize="36sp" />
        <TextView
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:background="@drawable/favorite_widget_preview_tile"
            android:fontFamily="sans-serif-medium"
            android:gravity="center"
            android:text="VIT"
            android:textColor="@color/glance_colorOnSecondaryContainer"
            android:textSize="10sp" />
    </LinearLayout>
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:maxLines="1"
        android:text="Bo3"
        android:textColor="@color/glance_colorOnSurfaceVariant"
        android:textSize="13sp" />
</LinearLayout>
